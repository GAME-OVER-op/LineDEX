<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="${applicationId}.permission.BIND_SYSTEM_BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
    </queries>

    <application
        android:name=".MagicDeskApplication"
        android:allowBackup="false"
        android:banner="@mipmap/ic_launcher"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">

        <!-- Legacy Xposed metadata. Revenge Xposed and LSPosed 1.x use it. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".LineDexControlActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DeviceSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/TransparentActivityTheme" />

        <!-- Kept for compatibility with the inherited desktop runtime. -->
        <activity
            android:name=".ControlActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.legacycontrol" />

        <activity
            android:name=".ConsoleSeedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:taskAffinity="${applicationId}.consoleseed"
            android:theme="@style/ConsoleSeedTheme" />

        <activity
            android:name=".DesktopActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:banner="@mipmap/ic_launcher"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="standard"
            android:logo="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.desktop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:launchMode="singleTop"
            android:resizeableActivity="true" />

        <activity
            android:name=".FreeformLaunchAnchorActivity"
            android:configChanges="density|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.desktoplaunch"
            android:theme="@style/TransparentActivityTheme" />

        <service
            android:name=".bridge.LineDexBridgeService"
            android:exported="true"
            android:permission="${applicationId}.permission.BIND_SYSTEM_BRIDGE"
            android:stopWithTask="false" />

        <service
            android:name=".MagicDeskRuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the LineDEX desktop session and task controls" />
        </service>

        <service
            android:name=".DesktopNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
